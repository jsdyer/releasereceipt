{
  "id": "releasereceipt",
  "title": "Release Receipt",
  "description": "Follow Statistics Canada releases, watch series and inspect changes to previously published values.",
  "category": "money",
  "tags": [
    "GDP",
    "Statistics Canada",
    "economic data",
    "revisions",
    "CPI",
    "earnings",
    "watchlist",
    "RSS",
    "calendar"
  ],
  "icon": "receipt-text",
  "url": "/releasereceipt/",
  "source": "https://github.com/jsdyer/releasereceipt",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "snapshot",
    "detail": "Archived GDP bulletins, StatCan vector observations and the official release calendar separate publication, reference and capture dates.",
    "cadence": "Twice weekly",
    "probes": [
      {
        "label": "Sources checked",
        "url": "https://coolcode.ca/releasereceipt/receipts.json",
        "path": [
          "checked"
        ],
        "count_at": {
          "path": [
            "releases"
          ],
          "measure": "length",
          "unit": "release bulletins"
        }
      },
      {
        "url": "https://coolcode.ca/releasereceipt/watchlist.json",
        "path": [
          "checked_at"
        ],
        "label": "Watchlist checked"
      }
    ]
  }
}
